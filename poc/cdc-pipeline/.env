# =============================================================================
# POC CDC Pipeline — Environment Variables
# =============================================================================

# --- PostgreSQL Legado (Source) ---
POSTGRES_LEGADO_HOST=postgres-legado
POSTGRES_LEGADO_PORT=5433
POSTGRES_LEGADO_DB=ecad_legado
POSTGRES_LEGADO_USER=ecad_user
POSTGRES_LEGADO_PASSWORD=ecad_pass

# --- PostgreSQL mcad (Sink) — usa o existente do docker-compose.dev.yml ---
POSTGRES_MCAD_HOST=host.docker.internal
POSTGRES_MCAD_PORT=5432
POSTGRES_MCAD_DB=mcad
POSTGRES_MCAD_USER=cadastro_svc
POSTGRES_MCAD_PASSWORD=cadastro_svc

# --- Kafka ---
KAFKA_BROKER=kafka:29092

# --- Kafka Connect ---
CONNECT_REST_PORT=8083

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8081

# --- ksqlDB ---
KSQLDB_PORT=8088

# --- Kafka UI ---
KAFKA_UI_PORT=8080
