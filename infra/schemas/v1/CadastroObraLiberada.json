{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schema-registry/v1/CadastroObraLiberada.json",
  "title": "CadastroObraLiberada",
  "description": "Publicado quando uma obra musical tem seu status alterado para LIBERADA, tornando-a disponivel para uso por outros dominios.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "const": "urn:cadastro-api" },
    "type": { "const": "cadastro.obra.liberada" },
    "subject": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": { "$ref": "#/$defs/data" }
  },
  "additionalProperties": true,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["obraId", "titulo"],
      "properties": {
        "obraId": { "type": "string", "format": "uuid" },
        "titulo": { "type": "string" },
        "iswc": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
