{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schema-registry/v1/ArrecadacaoPagamentoEstornado.json",
  "title": "ArrecadacaoPagamentoEstornado",
  "description": "Publicado quando um pagamento confirmado e estornado, com recalculo da verba do periodo.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "const": "urn:arrecadacao-api" },
    "type": { "const": "arrecadacao.pagamento.estornado" },
    "subject": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": { "$ref": "#/$defs/data" }
  },
  "additionalProperties": true,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["pagamentoId", "licencaId", "rubricaSigla", "periodo", "quantidadeUdas", "valorEstornado", "justificativa", "estornadoPor", "estornadoEm"],
      "properties": {
        "pagamentoId": { "type": "string", "format": "uuid" },
        "licencaId": { "type": "string", "format": "uuid" },
        "rubricaSigla": { "type": "string", "minLength": 1 },
        "periodo": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "quantidadeUdas": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "valorEstornado": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "justificativa": { "type": "string", "minLength": 1 },
        "estornadoPor": { "type": "string", "minLength": 1 },
        "estornadoEm": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
