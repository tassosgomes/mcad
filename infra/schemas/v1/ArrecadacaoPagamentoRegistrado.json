{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schema-registry/v1/ArrecadacaoPagamentoRegistrado.json",
  "title": "ArrecadacaoPagamentoRegistrado",
  "description": "Publicado ao registrar pagamento confirmado de uma licenca. Valores monetarios e quantidades sao strings com representacao decimal canonica (BigDecimal toPlainString).",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "const": "urn:arrecadacao-api" },
    "type": { "const": "arrecadacao.pagamento.registrado" },
    "subject": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": { "$ref": "#/$defs/data" }
  },
  "additionalProperties": true,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["pagamentoId", "licencaId", "periodo", "quantidadeUdas", "valorUdaNoMomento", "valorBruto", "status", "dataRegistro"],
      "properties": {
        "pagamentoId": { "type": "string", "format": "uuid" },
        "licencaId": { "type": "string", "format": "uuid" },
        "periodo": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "quantidadeUdas": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "valorUdaNoMomento": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "valorBruto": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        "status": { "const": "CONFIRMADO" },
        "dataRegistro": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
