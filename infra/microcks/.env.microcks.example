# .env do deploy do Microcks no Swarm. Copie para .env.microcks e preencha.
# O .env.microcks real e o realm renderizado NÃO vão para o git (ver .gitignore).

# ── Host / rota ──────────────────────────────────────────────────────────
# Host único (Microcks na raiz, Keycloak em /auth). Cadastrar no Cloudflare
# apontando para o nó do Swarm (mesmo destino dos demais mcad-*.tasso.dev.br).
MICROCKS_HOST=mcad-docs.tasso.dev.br

# ── Imagens (pinadas) ────────────────────────────────────────────────────
MICROCKS_IMAGE=quay.io/microcks/microcks:1.14.0
MICROCKS_POSTMAN_IMAGE=quay.io/microcks/microcks-postman-runtime:0.7.2
MICROCKS_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.0
MICROCKS_MONGO_IMAGE=mongo:4.4.29

# ── Keycloak ─────────────────────────────────────────────────────────────
# Admin do master realm (console do Keycloak):
KEYCLOAK_BOOTSTRAP_ADMIN=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_kc_master_admin
# Senha do usuário 'admin' DENTRO do realm 'microcks' (login do portal Microcks):
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_microcks_portal_admin
# Secret do client de automação (usado pelo import via API / CI):
MICROCKS_AUTOMATION_SECRET=CHANGE_ME_automation_client_secret

# ── Mongo ────────────────────────────────────────────────────────────────
# (deploy usa volume nomeado; sem credenciais por padrão, rede interna)

# ── Réplicas ─────────────────────────────────────────────────────────────
MICROCKS_REPLICAS=1
