{
  "name": "mcad-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:authz-lifecycle": "vitest run src/features/authz/contract/authzPermissionLifecycleContract.test.ts src/features/authz/types/permission.test.ts src/features/authz/components/PermissionStatusBadge.test.tsx src/features/authz/api/authzPermissionLifecycleApi.test.ts src/features/authz/hooks/usePermissionLifecycle.test.tsx src/features/authz/pages/PermissionCreatePage.test.tsx src/features/authz/pages/PermissionDetailPage.test.tsx src/features/authz/pages/PermissionsPage.test.tsx",
    "test:coverage:authz-lifecycle": "vitest run --config vitest.authz-lifecycle.config.ts --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.74.4",
    "lucide-react": "^0.487.0",
    "oidc-client-ts": "^3.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "5.8.3",
    "vite": "6.3.1",
    "vitest": "^4.1.5"
  }
}
