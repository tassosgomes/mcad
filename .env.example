# Database (Schema-per-Service — mesmo host, schemas isolados)
CADASTRO_DB_HOST=<db-host>
CADASTRO_DB_PORT=5432
CADASTRO_DB_NAME=<db-name>
CADASTRO_DB_USER=cadastro_svc
CADASTRO_DB_PASSWORD=<db-password>
CADASTRO_DB_SCHEMA=cadastro

IDENTIFICACAO_DB_HOST=<db-host>
IDENTIFICACAO_DB_PORT=5432
IDENTIFICACAO_DB_NAME=<db-name>
IDENTIFICACAO_DB_USER=gestauto
IDENTIFICACAO_DB_PASSWORD=<db-password>
IDENTIFICACAO_DB_SCHEMA=identificacao

DB_PASSWORD_DISTRIBUICAO=distribuicao_app
DB_USER_DISTRIBUICAO=distribuicao_app
DB_SCHEMA_DISTRIBUICAO=distribuicao

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001
SERVER_PORT_DISTRIBUICAO=5004

SUPER_USER=<super-user>
SUPER_PASS=<super-password>

RABBITMQ_URL=amqp://<user>:<password>@localhost:5672
RABBITMQ_VHOST=mcad
OUTBOX_POLL_INTERVAL_SECONDS=5

DISTRIBUICAO_EVENTS_EXCHANGE=distribuicao.events
DISTRIBUICAO_EVENTS_QUEUE=arrecadacao.distribuicao.processos
DISTRIBUICAO_EVENTS_ROUTING_KEY=distribuicao.processo.*

CADASTRO_API_BASE_URL=http://localhost:5001/api/v1
VITE_DISTRIBUICAO_API_BASE_URL=http://localhost:5004/api/v1
AUTHZ_API_BASE_URL=http://localhost:5200/api/authz/v1
AUTHZ_UPSTREAM_BASE_URL=https://mcad-authz.tasso.dev.br/v1

# Object Storage — dev local usa MinIO; em staging/prod usa Cloudflare R2 (ver bloco R2_* abaixo)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

OIDC_AUTHORITY=https://9lcinu.logto.app/oidc
OIDC_AUDIENCE=<logto-api-resource-indicator>
AUTH_ENABLED=true

LOGTO_M2M_CLIENT_ID=<logto-m2m-app-id>
LOGTO_M2M_CLIENT_SECRET=<logto-m2m-app-secret>
LOGTO_MANAGEMENT_API=https://9lcinu.logto.app/api

# Cloudflare R2 — preencha para apontar object storage para R2 em vez do MinIO local.
# Deixe R2_S3_API e R2_ACCOUNT_ID vazios para usar o MinIO (MINIO_* acima).
# R2_S3_API: URL completa do endpoint S3 (ex.: https://<account-id>.r2.cloudflarestorage.com).
#            Se não preenchida, é montada a partir de R2_ACCOUNT_ID.
R2_S3_API=<r2-s3-endpoint-url>
R2_ACCOUNT_ID=<id-da-conta-cloudflare>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=identificacao-uploads
# Bearer token da API nativa Cloudflare — NÃO usado pelo SDK S3; reservado para uso futuro.
R2_TOKEN_VALUE=<r2-bearer-token>
