# Database (Schema-per-Service — mesmo host, schemas isolados)
CADASTRO_DB_HOST=<db-host>
CADASTRO_DB_PORT=5432
CADASTRO_DB_NAME=<db-name>
CADASTRO_DB_USER=cadastro_svc
CADASTRO_DB_PASSWORD=<db-password>
CADASTRO_DB_SCHEMA=cadastro

IDENTIFICACAO_DB_HOST=<db-host>
IDENTIFICACAO_DB_PORT=5432
IDENTIFICACAO_DB_NAME=<db-name>
IDENTIFICACAO_DB_USER=gestauto
IDENTIFICACAO_DB_PASSWORD=<db-password>
IDENTIFICACAO_DB_SCHEMA=identificacao

DB_PASSWORD_DISTRIBUICAO=distribuicao_app
DB_USER_DISTRIBUICAO=distribuicao_app
DB_SCHEMA_DISTRIBUICAO=distribuicao

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001
SERVER_PORT_DISTRIBUICAO=5004

SUPER_USER=<super-user>
SUPER_PASS=<super-password>

RABBITMQ_URL=amqp://<user>:<password>@localhost:5672
RABBITMQ_VHOST=mcad
OUTBOX_POLL_INTERVAL_SECONDS=5

DISTRIBUICAO_EVENTS_EXCHANGE=distribuicao.events
DISTRIBUICAO_EVENTS_QUEUE=arrecadacao.distribuicao.processos
DISTRIBUICAO_EVENTS_ROUTING_KEY=distribuicao.processo.*

CADASTRO_API_BASE_URL=http://localhost:5001/api/v1
VITE_DISTRIBUICAO_API_BASE_URL=http://localhost:5004/api/v1
AUTHZ_API_BASE_URL=http://localhost:5200/api/authz/v1
AUTHZ_UPSTREAM_BASE_URL=https://mcad-authz.tasso.dev.br/v1

# BFF — endpoints proprios /api/me e /api/me/permissions consultam o ecad-authz
# para obter identidade e permissoes efetivas do usuario autenticado.
AUTHZ_BASE_URL=https://mcad-authz.tasso.dev.br
AUTHZ_TIMEOUT_MS=3000
# Deve permanecer <= 300 para cumprir o SLA de propagacao de permissoes.
ME_CACHE_TTL_SECONDS=60

# ecad-authz — autorizacao fina via SDK das APIs e seed (scripts/seed-authz.sh).
# AUTHZ_TIMEOUT_SECONDS é o equivalente em segundos de AUTHZ_TIMEOUT_MS, mantido por
# compatibilidade com integracoes legadas que esperam segundos.
AUTHZ_TIMEOUT_SECONDS=3
# Cache TTL local no SDK das APIs (Ecad.Authz.Sdk / authz-spring-boot-starter).
AUTHZ_CACHE_TTL_SECONDS=60
# Bearer token admin usado SOMENTE por scripts/seed-authz.sh para popular o catalogo,
# papeis e atribuicoes no ecad-authz. NAO usar em runtime das APIs.
AUTHZ_ADMIN_TOKEN=<authz-admin-bearer-token>
# Tokens de servico — um por API — para o SDK chamar o ecad-authz em runtime.
AUTHZ_SERVICE_TOKEN_CADASTRO=<service-token-cadastro>
AUTHZ_SERVICE_TOKEN_IDENTIFICACAO=<service-token-identificacao>
AUTHZ_SERVICE_TOKEN_ARRECADACAO=<service-token-arrecadacao>

# AI Orchestrator / Copiloto Operacional
AI_ORCHESTRATOR_BASE_URL=http://localhost:5300/v1
AI_HOST=0.0.0.0
AI_PORT=5300
AI_ENVIRONMENT=local
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4.1-mini
AI_STORAGE_URL=
AI_TOOL_TIMEOUT_MS=10000
AI_MAX_MESSAGE_CHARS=4000
AI_TRACE_PROMPTS=false

# Object Storage — dev local usa MinIO; em staging/prod usa Cloudflare R2 (ver bloco R2_* abaixo)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

OIDC_AUTHORITY=https://9lcinu.logto.app/oidc
OIDC_AUDIENCE=<logto-api-resource-indicator>
# Logto provisioning é authentication-only: SPA, API Resource/audience e usuários
# de teste. Não cria roles, não atribui roles e remove customizer legado de roles no JWT.
# Para fixtures DEV/CI de acesso, rode scripts/seed-authz.sh com AUTHZ_ADMIN_TOKEN.
LOGTO_M2M_CLIENT_ID=<logto-m2m-app-id>
LOGTO_M2M_CLIENT_SECRET=<logto-m2m-app-secret>
LOGTO_MANAGEMENT_API=https://9lcinu.logto.app/api
# Optional: pre-issued Logto Management API bearer token for one-off migration
# scripts. If omitted, scripts use LOGTO_M2M_CLIENT_ID/LOGTO_M2M_CLIENT_SECRET.
LOGTO_MANAGEMENT_TOKEN=<logto-management-bearer-token>

# One-off controlled backfill from Logto roles to ecad-authz assignments.
# These defaults are consumed by scripts/migrate-logto-roles-to-authz-assignments.mjs.
AUTHZ_ASSIGNMENTS_MIGRATION_REPORT=tasks/plataforma/prd-authz-fonte-unica-assignments/migration-report.md

# Cloudflare R2 — preencha para apontar object storage para R2 em vez do MinIO local.
# Deixe R2_S3_API e R2_ACCOUNT_ID vazios para usar o MinIO (MINIO_* acima).
# R2_S3_API: URL completa do endpoint S3 (ex.: https://<account-id>.r2.cloudflarestorage.com).
#            Se não preenchida, é montada a partir de R2_ACCOUNT_ID.
R2_S3_API=<r2-s3-endpoint-url>
R2_ACCOUNT_ID=<id-da-conta-cloudflare>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=identificacao-uploads
# Bearer token da API nativa Cloudflare — NÃO usado pelo SDK S3; reservado para uso futuro.
R2_TOKEN_VALUE=<r2-bearer-token>
