{
  "asyncapi": "2.4.0",
  "channels": {
    "identificacao.rol.cancelado": {
      "bindings": {
        "amqp": {
          "exchange": {
            "autoDelete": false,
            "durable": true,
            "name": "identificacao.events",
            "type": "topic",
            "vhost": "mcad"
          },
          "is": "routingKey"
        }
      },
      "description": "Publicado quando uma captação/rol é cancelada pelo analista responsável (opcionalmente com recriação). Downstream: Distribuição consome este evento para invalidar cálculos associados ao rol anterior.",
      "publish": {
        "message": {
          "$ref": "#/components/messages/RolCancelado"
        },
        "operationId": "publicarRolCancelado",
        "summary": "Rol de execuções cancelado",
        "tags": [
          {
            "name": "cancelamento"
          }
        ]
      }
    },
    "identificacao.rol.fechado": {
      "bindings": {
        "amqp": {
          "exchange": {
            "autoDelete": false,
            "durable": true,
            "name": "identificacao.events",
            "type": "topic",
            "vhost": "mcad"
          },
          "is": "routingKey"
        }
      },
      "description": "Publicado quando um Rol de Execuções é fechado pelo analista. Contém todas as execuções musicais da captação no período informado. Downstream: Distribuição consome este evento para iniciar o cálculo de créditos.",
      "publish": {
        "message": {
          "$ref": "#/components/messages/RolFechado"
        },
        "operationId": "publicarRolFechado",
        "summary": "Rol de execuções fechado",
        "tags": [
          {
            "name": "fechamento"
          }
        ]
      }
    }
  },
  "components": {
    "channelBindings": {
      "amqp": {
        "amqp": {
          "exchange": {
            "autoDelete": false,
            "durable": true,
            "name": "identificacao.events",
            "type": "topic",
            "vhost": "mcad"
          },
          "is": "routingKey"
        }
      }
    },
    "messages": {
      "RolCancelado": {
        "contentType": "application/cloudevents+json",
        "examples": [
          {
            "name": "RolCancelado",
            "payload": {
              "data": {
                "analistaId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7081",
                "canceladoEm": "2026-02-11T09:30:00Z",
                "captacaoId": "b2c3d4e5-f6a7-4b8c-9d0e-2f3a4b5c6d7e",
                "justificativa": "Captação reprocessada por inconsistência na fonte de dados.",
                "periodo": "2026-01",
                "rubrica": "TVABERTA"
              },
              "datacontenttype": "application/json",
              "id": "d0a80201-0002-4a2b-8c3d-000000000002",
              "source": "urn:identificacao-api",
              "specversion": "1.0",
              "subject": "captacao/b2c3d4e5-f6a7-4b8c-9d0e-2f3a4b5c6d7e",
              "time": "2026-02-11T09:30:00Z",
              "type": "identificacao.rol.cancelado"
            },
            "summary": "Rol de execuções cancelado pelo analista (exemplo de mock)"
          }
        ],
        "name": "RolCancelado",
        "payload": {
          "$ref": "#/components/schemas/rolCanceladoPayload"
        },
        "summary": "Rol de execuções musicais cancelado",
        "title": "Rol Cancelado"
      },
      "RolFechado": {
