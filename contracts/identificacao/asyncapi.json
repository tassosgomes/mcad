                "fechadoEm": "2026-02-10T18:00:00Z",
                "periodo": "2026-01",
                "rubrica": "RADIO"
              },
              "datacontenttype": "application/json",
              "id": "d0a80201-0001-4a2b-8c3d-000000000001",
              "source": "urn:identificacao-api",
              "specversion": "1.0",
              "subject": "captacao/a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
              "time": "2026-02-10T18:00:00Z",
              "type": "identificacao.rol.fechado"
            },
            "summary": "Rol de execuções fechado pelo analista (exemplo de mock)"
          }
        ],
        "name": "RolFechado",
        "payload": {
          "$ref": "#/components/schemas/rolFechadoPayload"
        },
        "summary": "Rol de execuções musicais fechado — pronto para distribuição de créditos",
        "title": "Rol Fechado"
      }
    },
    "schemas": {
      "execucaoRolPayload": {
        "additionalProperties": false,
        "id": "execucaoRolPayload",
        "properties": {
          "duracaoSegundos": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "fim": {
            "type": [
              "null",
              "string"
            ]
          },
          "fonogramaId": {
            "format": "guid",
            "type": [
              "null",
              "string"
            ]
          },
          "inicio": {
            "type": [
              "null",
              "string"
            ]
          },
          "obraId": {
            "format": "guid",
            "type": "string"
          },
          "peso": {
            "format": "decimal",
            "type": [
              "null",
              "number"
            ]
          },
          "quantidade": {
            "format": "int32",
            "type": "integer"
          },
          "tipoUtilizacao": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "rolCanceladoPayload": {
        "additionalProperties": false,
        "id": "rolCanceladoPayload",
        "properties": {
          "analistaId": {
            "format": "guid",
            "type": "string"
          },
          "canceladoEm": {
            "format": "date-time",
            "type": "string"
          },
          "captacaoId": {
            "format": "guid",
            "type": "string"
          },
          "justificativa": {
            "type": "string"
          },
          "periodo": {
            "type": "string"
          },
          "rubrica": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "rolFechadoPayload": {
        "additionalProperties": false,
        "id": "rolFechadoPayload",
        "properties": {
          "analistaId": {
            "format": "guid",
            "type": "string"
          },
          "captacaoId": {
            "format": "guid",
            "type": "string"
          },
          "execucoes": {
            "items": {
              "$ref": "#/components/schemas/execucaoRolPayload"
            },
            "type": "array"
          },
          "fechadoEm": {
            "format": "date-time",
            "type": "string"
          },
          "periodo": {
            "type": "string"
          },
          "rubrica": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "defaultContentType": "application/json",
  "info": {
    "description": "Eventos publicados pelo domínio de **Identificação** via RabbitMQ.\n\n**Formato:** CloudEvents 1.0 (`application/cloudevents+json`)\n\n**Entrega:** at-least-once via Transactional Outbox (`identificacao.outbox_events`)\n\nOs schemas representam o campo `data` do envelope CloudEvents.",
    "title": "Identificacao API Eventos Assincronos",
    "version": "1.0.0"
  },
  "servers": {
    "development": {
      "description": "RabbitMQ local — docker-compose.dev.yml (vhost: mcad)",
      "protocol": "amqp",
      "url": "amqp://localhost:5672"
    }
  }
}
