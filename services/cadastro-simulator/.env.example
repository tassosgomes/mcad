# URL real da cadastro-api (subdomínio dedicado, separado do frontend)
API_BASE_URL=https://mcad-cadastro.tasso.dev.br/api/v1

# Logto OIDC
OIDC_AUTHORITY=https://9lcinu.logto.app/oidc
OIDC_RESOURCE=https://api.mcad.local

# Credenciais da app M2M 'mcad-simulator' (geradas pelo provision-logto.sh)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Modo de autenticação:
#   client_credentials  → M2M; mais simples; actor.username dos audit events vira "system".
#   refresh_token       → usa refresh_token de usuário real; preserva actor.username = analista_cadastro.
#                         Captura manual: logue no frontend (https://mcad.tasso.dev.br),
#                         abra DevTools, localStorage, copie o refresh_token do storage do Logto
#                         e cole em INITIAL_REFRESH_TOKEN.
AUTH_MODE=client_credentials
INITIAL_REFRESH_TOKEN=

# Mix por ciclo
READS_PER_CYCLE=3
WRITES_PER_CYCLE=1
UPDATES_PER_CYCLE=1

# Intervalo entre ciclos (segundos). 300 = 5 min, mantém ~1 cadastro/5min.
CYCLE_INTERVAL_SECONDS=300

# Pausa entre operações dentro do mesmo ciclo
INTRA_CYCLE_DELAY_SECONDS=2
