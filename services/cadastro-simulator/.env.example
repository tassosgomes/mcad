# Endereço da API de cadastro (sem trailing slash)
API_BASE_URL=https://mcad.tasso.dev.br/api/v1

# Logto OIDC
OIDC_AUTHORITY=https://9lcinu.logto.app/oidc
OIDC_RESOURCE=https://api.mcad.local

# Credenciais da app Traditional 'mcad-simulator' (geradas pelo provision-logto.sh)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Usuário Logto (analista_cadastro tem role analista-cadastro = leitura+escrita)
SIM_USERNAME=analista_cadastro
SIM_PASSWORD=Analista123!

# Mix por ciclo
READS_PER_CYCLE=3
WRITES_PER_CYCLE=1
UPDATES_PER_CYCLE=1

# Intervalo entre ciclos (segundos). 300 = 5 min, mantém ~1 cadastro/5min como simulado.
CYCLE_INTERVAL_SECONDS=300

# Pausa entre operações dentro do mesmo ciclo
INTRA_CYCLE_DELAY_SECONDS=2
