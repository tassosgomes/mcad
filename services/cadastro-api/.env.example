# Database
CADASTRO_DB_HOST=localhost
CADASTRO_DB_PORT=5432
CADASTRO_DB_NAME=postgres
CADASTRO_DB_SCHEMA=cadastro
CADASTRO_DB_USER=postgres
CADASTRO_DB_PASSWORD=postgres

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001
OIDC_AUTHORITY=https://keycloak.tasso.dev.br/realms/mcad
OIDC_AUDIENCE=mcad-frontend
AUTH_ENABLED=true

# RabbitMQ (F08 — Outbox Pattern)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_SECONDS=5

# ISWC Service — URL do serviço externo de geração de ISWC
# Default (sem env var): https://iswc.tasso.dev.br/
# Para validação local com simulador de carga, use o mock:
#   ISWC_BASE_URL=http://localhost:8090
ISWC_BASE_URL=https://iswc.tasso.dev.br/
