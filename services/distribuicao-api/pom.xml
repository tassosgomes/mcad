<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.ecad</groupId>
    <artifactId>distribuicao-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>distribuicao-parent</name>
    <description>Parent Maven project for the distribuicao-api service.</description>

    <modules>
        <module>distribuicao-api</module>
        <module>distribuicao-application</module>
        <module>distribuicao-domain</module>
        <module>distribuicao-infra</module>
        <module>distribuicao-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.3.5</spring-boot.version>
        <cloudevents.version>3.0.0</cloudevents.version>
        <audit-sdk.version>1.0.0</audit-sdk.version>
        <authz-sdk.version>0.1.0-SNAPSHOT</authz-sdk.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <awaitility.version>4.2.1</awaitility.version>
        <opentelemetry.version>1.42.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.8.0</opentelemetry-instrumentation.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>github-ecad-auditoria</id>
            <url>https://maven.pkg.github.com/tassosgomes/ecad-auditoria</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-ecad-authz</id>
            <url>https://maven.pkg.github.com/tassosgomes/ecad-authz</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- testcontainers-bom DEVE vir antes de spring-boot-dependencies:
                 a BOM do Spring Boot 3.3.5 amarra testcontainers em 1.19.8,
                 que envia API 1.32 ao Docker daemon (rejeitada por engines >= 25.0
                 que exigem MinAPI 1.44). Importar a BOM do testcontainers primeiro
                 garante que a 1.21.3 vencera.
                 Complemento: ver distribuicao-tests/src/test/resources/docker-java.properties
                 (workaround para o ping inicial enviar api.version=1.44; necessario ate
                 bumparmos para testcontainers 2.x). Issue:
                 https://github.com/testcontainers/testcontainers-java/issues/11210 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- OpenTelemetry BOMs DEVEM vir antes de spring-boot-dependencies:
                 Spring Boot 3.3.5 pina opentelemetry-api em 1.37.0, mas a
                 instrumentacao 2.8.x exige 1.42.0+ (classe
                 io.opentelemetry.api.internal.InstrumentationUtil). Importar a
                 BOM core do OTel primeiro garante que 1.42.0 vence para todos
                 os modulos. -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
