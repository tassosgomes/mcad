<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.ecad</groupId>
        <artifactId>distribuicao-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>distribuicao-api</artifactId>
    <name>distribuicao-api</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>br.com.ecad</groupId>
            <artifactId>distribuicao-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.ecad</groupId>
            <artifactId>distribuicao-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.org.ecad.audit</groupId>
            <artifactId>audit-sdk-spring-boot-starter</artifactId>
            <version>${audit-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>br.org.ecad.authz</groupId>
            <artifactId>authz-spring-boot-starter</artifactId>
            <version>${authz-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- classifier=exec preserva o JAR thin original como artefato
                                 default; o executable fat JAR vira distribuicao-api-X-exec.jar.
                                 Necessario para que distribuicao-tests consiga resolver
                                 dependencia do modulo distribuicao-api (caso contrario o
                                 fat JAR substitui o thin e o classpath de teste quebra). -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
