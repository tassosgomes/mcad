IDENTIFICACAO_DB_HOST=localhost
IDENTIFICACAO_DB_PORT=5432
IDENTIFICACAO_DB_NAME=mcad
IDENTIFICACAO_DB_USER=postgres
IDENTIFICACAO_DB_PASSWORD=postgres
IDENTIFICACAO_DB_SCHEMA=identificacao

AUTH_ENABLED=true
OIDC_AUTHORITY=http://localhost:8080/realms/mcad
OIDC_AUDIENCE=mcad-frontend

# Ecad.Authz — serviço externo de autorização fina (PDP)
EcadAuthz__Enabled=true
EcadAuthz__BaseUrl=http://localhost:8081/v1
EcadAuthz__TimeoutSeconds=3
EcadAuthz__CacheTtlSeconds=30

CADASTRO_API_BASE_URL=http://localhost:5001/api/v1

# M2M (client_credentials) para o cadastro-api — obrigatório quando AUTH_ENABLED=true no cadastro
# Cliente machine-to-machine provisionado no Logto, com papel concedendo leitura de obra/fonograma
CADASTRO_LOGTO_ISSUER=https://9lcinu.logto.app/oidc
CADASTRO_LOGTO_CLIENT_ID=
CADASTRO_LOGTO_CLIENT_SECRET=
CADASTRO_LOGTO_RESOURCE=
CADASTRO_LOGTO_SCOPE=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mcadadmin
MINIO_SECRET_KEY=mcadadmin123

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
