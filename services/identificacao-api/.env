# Database (local via docker-compose)
IDENTIFICACAO_DB_HOST=db.tasso.dev.br
IDENTIFICACAO_DB_PORT=5432
IDENTIFICACAO_DB_NAME=mcad
IDENTIFICACAO_DB_USER=gestauto
IDENTIFICACAO_DB_PASSWORD=gestauto123
IDENTIFICACAO_DB_SCHEMA=identificacao

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001

SUPER_USER=gestauto
SUPER_PASS=gestauto123

RABBITMQ_URL=amqp://mcad:mcad@rabbitmq.tasso.dev.br:5672
RABBITMQ_VHOST=mcad
OUTBOX_POLL_INTERVAL_SECONDS=5

CADASTRO_API_BASE_URL=http://localhost:5001/api/v1

MINIO_ENDPOINT=https://minio-api.tasso.dev.br
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

OIDC_AUTHORITY=https://keycloak.tasso.dev.br/realms/mcad
OIDC_AUDIENCE=mcad-frontend
AUTH_ENABLED=true