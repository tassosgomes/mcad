# MCAD local/hybrid development example.
# Copy to .env.local and fill only the secrets you need. Do not commit .env.local.

# -----------------------------------------------------------------------------
# Execution mode
# -----------------------------------------------------------------------------

# Default uses the SSH alias documented in docs/ops/server-access-recovery.md:
#   Host mcad-pg
#     LocalForward 15432 shared-postgres:5432
MCAD_DB_MODE=ssh-tunnel
MCAD_DB_SSH_HOST=mcad-server
MCAD_DB_REMOTE_HOST=shared-postgres
MCAD_DB_REMOTE_PORT=5432
MCAD_DB_LOCAL_HOST=127.0.0.1
# Optional. Leave empty to let dev.sh choose the first free port from 15432..15442.
MCAD_DB_LOCAL_PORT=
MCAD_DEV_DB_NAME=mcad

# Alternative modes:
# MCAD_DB_MODE=direct        # use DB hosts/ports below directly
# MCAD_DB_MODE=local-compose # use local Postgres from docker-compose.dev.yml

# -----------------------------------------------------------------------------
# PostgreSQL credentials
# -----------------------------------------------------------------------------

CADASTRO_DB_USER=cadastro_svc
CADASTRO_DB_PASSWORD=<cadastro-db-password>
CADASTRO_DB_SCHEMA=cadastro

IDENTIFICACAO_DB_USER=identificacao_svc
IDENTIFICACAO_DB_PASSWORD=<identificacao-db-password>
IDENTIFICACAO_DB_SCHEMA=identificacao

ARRECADACAO_DB_USER=arrecadacao_svc
ARRECADACAO_DB_PASSWORD=<arrecadacao-db-password>
ARRECADACAO_DB_SCHEMA=arrecadacao

DB_USER_DISTRIBUICAO=distribuicao_app
DB_PASSWORD_DISTRIBUICAO=<distribuicao-db-password>
DB_SCHEMA_DISTRIBUICAO=distribuicao

# Direct DB mode only.
CADASTRO_DB_HOST=<db-host>
CADASTRO_DB_PORT=5432
CADASTRO_DB_NAME=mcad
IDENTIFICACAO_DB_HOST=<db-host>
IDENTIFICACAO_DB_PORT=5432
IDENTIFICACAO_DB_NAME=mcad
ARRECADACAO_DB_HOST=<db-host>
ARRECADACAO_DB_PORT=5432
ARRECADACAO_DB_NAME=mcad
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=mcad

# -----------------------------------------------------------------------------
# Cloud/dev infrastructure
# -----------------------------------------------------------------------------

OIDC_AUTHORITY=https://9lcinu.logto.app/oidc
OIDC_CLIENT_ID=mcad-frontend
OIDC_AUDIENCE=https://api.mcad.local
AUTH_ENABLED=true

# RabbitMQ is cloud/dev by default. Java services need the split fields; .NET
# services can use RABBITMQ_URL.
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672/<vhost>
RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USER=<rabbitmq-user>
RABBITMQ_PASSWORD=<rabbitmq-password>
RABBITMQ_VHOST=<rabbitmq-vhost>
# Set automatically by dev.sh when RABBITMQ_URL starts with amqps://.
SPRING_RABBITMQ_SSL_ENABLED=true

# Redis is not started by this repo in the default flow. The ecad-authz cloud/dev
# service owns its Redis cache; keep local Redis only for the optional authz profile.

MINIO_ENDPOINT=https://minio-api.tasso.dev.br
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

AUTHZ_BASE_URL=https://mcad-authz.tasso.dev.br
AUTHZ_UPSTREAM_BASE_URL=https://mcad-authz.tasso.dev.br/v1
AUTHZ_TIMEOUT_MS=3000
AUTHZ_TIMEOUT_SECONDS=3
AUTHZ_CACHE_TTL_SECONDS=60

# Required only for authz seeding/admin scripts.
AUTHZ_ADMIN_TOKEN=<authz-admin-bearer-token>
AUTHZ_SERVICE_TOKEN_CADASTRO=<service-token-cadastro>
AUTHZ_SERVICE_TOKEN_IDENTIFICACAO=<service-token-identificacao>
AUTHZ_SERVICE_TOKEN_ARRECADACAO=<service-token-arrecadacao>

# Required only for identity-sync-api.
LOGTO_M2M_CLIENT_ID=<logto-m2m-client-id>
LOGTO_M2M_CLIENT_SECRET=<logto-m2m-client-secret>
LOGTO_MANAGEMENT_API=https://9lcinu.logto.app/api
IDENTITY_SYNC_ADMIN_TOKEN=<identity-sync-admin-token>
IDENTITY_SYNC_PORT=5301

# Required only for ai-orchestrator real OpenAI calls. Tests/local deterministic
# behavior can use OPENAI_API_KEY=test-key.
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# Remote development upstreams used by dev.sh when a service is not local
# -----------------------------------------------------------------------------

DEV_BFF_BASE_URL=https://mcad-bff.tasso.dev.br
DEV_CADASTRO_API_BASE_URL=https://mcad-cadastro.tasso.dev.br/api/v1
DEV_IDENTIFICACAO_API_BASE_URL=https://mcad-identificacao.tasso.dev.br/api/v1
DEV_ARRECADACAO_API_BASE_URL=https://mcad-arrecadacao.tasso.dev.br/api/v1
DEV_DISTRIBUICAO_API_BASE_URL=https://mcad-distribuicao.tasso.dev.br/api/v1
DEV_AI_ORCHESTRATOR_BASE_URL=https://mcad-bff.tasso.dev.br/api/ai/v1
DEV_AUTHZ_BASE_URL=https://mcad-authz.tasso.dev.br
DEV_AUTHZ_UPSTREAM_BASE_URL=https://mcad-authz.tasso.dev.br/v1

AUDITORIA_API_BASE_URL=https://api-audit.tasso.dev.br/api/v1
AUDIT_BASE_URL=https://api-audit.tasso.dev.br/api/v1

# Frontend dev-server proxy. dev.sh sets this automatically:
# - http://localhost:5200 when bff is local
# - DEV_BFF_BASE_URL when bff is remote
VITE_BFF_PROXY_TARGET=
FRONTEND_PORT=5173
FRONTEND_STRICT_PORT=true
