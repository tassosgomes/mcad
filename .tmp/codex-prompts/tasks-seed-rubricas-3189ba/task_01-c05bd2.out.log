8080\"\n    depends_on:\n      mcad-postgres:\n        condition: service_healthy\n    healthcheck:\n      test: [\"CMD-SHELL\", \"curl -fsS http://localhost:8080/health/ready || exit 1\"]\n      interval: 15s\n      timeout: 10s\n      retries: 20\n      start_period: 60s\n\n  # ── MinIO ─────────────────────────────────────────────────────────\n  mcad-minio:\n    image: minio/minio:latest\n    container_name: mcad-minio\n    restart: unless-stopped\n    command: server /data --console-address \":9001\"\n    environment:\n      MINIO_ROOT_USER: mcadadmin\n      MINIO_ROOT_PASSWORD: mcadadmin123\n    ports:\n      - \"9000:9000\"\n      - \"9001:9001\"\n    volumes:\n      - mcad_minio_data:/data\n    healthcheck:\n      test: [\"CMD\", \"mc\", \"ready\", \"local\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n\n# NOTE: cadastro-api e identificacao-api rodam no host via `dotnet run`\n# Ver README para instruções de execução local das APIs\n\nvolumes:\n  mcad_pg_data:\n  mcad_rmq_data:\n  mcad_minio_data:\n","exit_code":0,"status":"completed"}}
